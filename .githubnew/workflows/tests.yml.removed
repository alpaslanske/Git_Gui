name: Tests

on:
  pull_request:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Check Python syntax
        run: |
          python - <<'PY'
          import ast
          from pathlib import Path

          files = [
              Path("git_gui.py"),
              Path("git_motoru.py"),
              Path("lang.py"),
              Path("tests/test_git_motoru.py"),
          ]
          for source in files:
              ast.parse(source.read_text(encoding="utf-8"), filename=str(source))
          PY

      - name: Run Git engine tests
        run: python -m unittest discover -s tests -v
